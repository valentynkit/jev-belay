# One of these two. Without either, the hook exits 0 and does nothing.
TYPESAFE_API_KEY=            # required, unless JEV_BASE_URL points at a shim that holds the key
JEV_BASE_URL=                # optional, http://127.0.0.1:4322 for the gateway shim or the fake

JEV_BELAY_THRESHOLD=0.75     # optional, claims_done cutoff
JEV_BELAY_LOG=               # optional, 1 writes ~/.claude/belay/decisions.jsonl for `belay.mjs watch`
JEV_BELAY_TIMEOUT_MS=20000   # optional, whole-call budget including retries
JEV_MODEL=jev-1.13.0         # optional, pinned so a moving alias cannot move the thresholds
